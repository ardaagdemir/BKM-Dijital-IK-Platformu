<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.bkm</groupId>
        <artifactId>dijital-ik-platformu</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>amenities</artifactId>
    <name>amenities</name>
    <description>Çalışan olanakları modülü (roadmap Bölüm 8, EPIC-08G Sosyal Kulüp + EPIC-08H Randevu) —
        eskiden ayrı `club`/`appointment` modülleriydi; ikisi de küçük, teknik olarak bağımsız ama ikisi de
        opsiyonel/self-servis çalışan olanağı olduğundan tek modülde birleştirildi. Yalnızca core'a bağımlıdır.</description>

    <dependencies>
        <dependency>
            <groupId>com.bkm</groupId>
            <artifactId>core</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- US-08H.1.3: Kayıt bazlı yetkilendirme (@PreAuthorize, AppointmentNoteController) için gerekli.
             Bilinçli olarak yalnızca spring-security-CORE eklendi —
             organization/leave/training/travel modüllerindeki AYNI gerekçe:
             bu modül auth'a bağımlı olmadığından yalnızca Spring Security'nin
             jenerik Authentication/GrantedAuthority API'sini kullanır.
             @EnableMethodSecurity, auth modülündeki SecurityConfig'te zaten etkin. -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-core</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Yalnızca test: bu modülü tek başına (bkz. AmenitiesTestApplication) test edebilmek için. -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
