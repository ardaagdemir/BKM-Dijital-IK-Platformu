<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.bkm</groupId>
        <artifactId>dijital-ik-platformu</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>recruitment</artifactId>
    <name>recruitment</name>
    <description>İşe alım modülü (roadmap Bölüm 5). Yalnızca core'a bağımlıdır.</description>

    <dependencies>
        <dependency>
            <groupId>com.bkm</groupId>
            <artifactId>core</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- US-05.3.2: Kayıt bazlı yetkilendirme (@PreAuthorize, Authentication,
             GrantedAuthority) için gerekli — organization/leave modüllerinin
             US-03.2.6/US-04.2.2'de yaptığı aynı seçim: yalnızca
             spring-security-CORE, tam starter DEĞİL. -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-core</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Yalnızca test: bu modülü tek başına (bkz. RecruitmentTestApplication) test edebilmek için. -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
