<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.bkm</groupId>
    <artifactId>dijital-ik-platformu</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>dijital-ik-platformu</name>
    <description>Dijital Insan Kaynaklari Platformu — modüler monolith (her modül ayrı bir Maven modülüdür).
        Bu kök pom yalnızca aggregator'dır ve kod içermez (Maven, &lt;modules&gt; tanımlayan
        bir projenin packaging=pom olmasını zorunlu kılar) — çalıştırılabilir uygulama
        "bootstrap" modülündedir.
    </description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <!--
        Modül sırası önemlidir: core hiçbir modüle bağımlı değildir (paylaşılan çekirdek);
        her iş modülü (auth, ileride organization/leave/recruitment/...) yalnızca core'a
        bağımlıdır; bootstrap, tüm modülleri bir araya getirip çalıştırılabilir jar üretir.
    -->
    <modules>
        <module>core</module>
        <module>platform</module>
        <module>auth</module>
        <module>organization</module>
        <module>leave</module>
        <module>recruitment</module>
        <module>performance</module>
        <module>attendance</module>
        <module>training</module>
        <module>travel</module>
        <module>discipline</module>
        <module>feedback</module>
        <module>amenities</module>
        <module>payroll</module>
        <module>bootstrap</module>
    </modules>

</project>
