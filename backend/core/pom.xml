<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.bkm</groupId>
        <artifactId>dijital-ik-platformu</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>core</artifactId>
    <name>core</name>
    <description>Paylaşılan çekirdek: taban entity, audit altyapısı, platform geneli hata işleme. Hiçbir başka modüle bağımlı değildir; her modül buna bağımlıdır.</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- US-09.3.1: Merkezi bildirim altyapısı (core.notification) burada yaşıyor —
             leave/auth modüllerindeki AYNI mail bağımlılığının core'a taşınmış hali.
             Saf altyapı (SMTP gönderim mekanizması) olduğundan, iş mantığı İÇERMediğinden
             core'a eklenmesi ADR'ye aykırı değil (bkz. core.notification paketinin javadoc'u). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!-- US-09.4.1: Merkezi dışa aktarma bileşeni (core.export) — Excel (XLSX)
             üretimi için. Ücretsiz/açık kaynak, harici bir servis DEĞİL. -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.3.0</version>
        </dependency>

        <!-- Bölüm 13.8/9.6: AuditLogController'ın @PreAuthorize'ı için gerekli.
             organization/pom.xml'deki AYNI gerekçeyle, bilinçli olarak yalnızca
             spring-security-CORE eklendi — auth modülündeki tam
             spring-boot-starter-security DEĞİL: core, auth'a bağımlı OLAMAZ
             (core hiçbir modüle bağımlı değildir kuralı, bkz. ADR-002); yalnızca
             Spring Security'nin jenerik Authentication/GrantedAuthority API'sini
             kullanır. @EnableMethodSecurity zaten auth modülündeki
             SecurityConfig'te (uygulama genelinde tek bir Spring context
             olduğundan) etkin; core'un kendisi bunu etkinleştirmez. -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-core</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Yalnızca test: bu modülü tek başına (bkz. CoreTestApplication) test edebilmek için
             bellek içi veritabanı; gerçek PostgreSQL sürücüsü/Flyway bağımlılığı bootstrap modülünde. -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
