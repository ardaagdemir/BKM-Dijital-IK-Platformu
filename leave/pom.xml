<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.bkm</groupId>
        <artifactId>dijital-ik-platformu</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>leave</artifactId>
    <name>leave</name>
    <description>İzin yönetimi modülü (roadmap Bölüm 4). Yalnızca core'a bağımlıdır.</description>

    <dependencies>
        <dependency>
            <groupId>com.bkm</groupId>
            <artifactId>core</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- US-04.2.2: Kayıt bazlı yetkilendirme (@PreAuthorize, Authentication,
             GrantedAuthority) için gerekli — organization modülünün US-03.2.6'da
             yaptığı aynı seçim: yalnızca spring-security-CORE, tam
             spring-boot-starter-security DEĞİL (bu modül auth'a bağımlı değil,
             yalnızca jenerik rol/yetki API'sini kullanır). -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-core</artifactId>
        </dependency>

        <!-- US-04.3.1: İzin talebi onay/ret e-postası — bkz. Feature 04.3'ün
             YAGNI notu: genel bir bildirim motoru DEĞİL, izin modülüne özel,
             tek şablonlu bir SMTP gönderimi. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Yalnızca test: bu modülü tek başına (bkz. LeaveTestApplication) test edebilmek için. -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
